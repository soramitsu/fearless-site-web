{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "audit:dependencies": "yarn npm audit --all --recursive --severity low --no-deprecations",
    "audit:dependencies:production": "yarn npm audit --all --recursive --environment production --severity low --no-deprecations",
    "dev": "yarn parseNetworks && nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "parseNetworks": "tsx ./parseNetworks.ts > ./src/components/Network/networks.ts",
    "verify:release-content": "node scripts/verify-release-content.mjs",
    "verify:app-associations": "node scripts/verify-app-associations.mjs",
    "verify:app-associations:live": "node scripts/verify-app-associations.mjs --live-base-url https://fearlesswallet.io",
    "test:app-associations": "bash scripts/test-app-associations.sh",
    "typecheck": "nuxt typecheck",
    "notes": "node ./fetchReleaseNotes.js"
  },
  "dependencies": {
    "@nuxt/content": "^2.13.2",
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/sitemap": "7.4.3",
    "@unhead/vue": "^2.1.15",
    "matter-js": "^0.20.0",
    "nuxt": "^3.21.7",
    "nuxt-schema-org": "5.0.6",
    "ogl": "^1.0.8",
    "remark-breaks": "^4.0.0",
    "unhead": "^2.1.15",
    "vue": "^3.5.38",
    "vue-router": "^4.4.5",
    "zod": "^3.25.76"
  },
  "resolutions": {
    "@nuxtjs/mdc": "0.17.2",
    "@ungap/structured-clone": "1.3.1",
    "brace-expansion": "2.1.4",
    "defu": "6.1.7",
    "glob": "10.5.0",
    "h3": "1.15.11",
    "ipx": "2.1.1",
    "listhen": "1.10.0",
    "lodash": "4.18.1",
    "mdast-util-to-hast": "13.2.1",
    "node-forge": "1.4.0",
    "picomatch@npm:^4.0.2": "npm:4.0.5",
    "picomatch@npm:^4.0.3": "npm:4.0.5",
    "picomatch@npm:^4.0.4": "npm:4.0.5",
    "fast-xml-parser": "5.10.1",
    "postcss": "8.5.25",
    "readdir-glob/minimatch": "5.1.9",
    "glob/minimatch": "9.0.9",
    "anymatch/picomatch": "2.3.2",
    "micromatch/picomatch": "2.3.2",
    "tinyglobby/picomatch": "4.0.5",
    "unimport/picomatch": "4.0.5",
    "rollup": "4.62.2",
    "sharp": "0.35.3",
    "sharp/tar-fs": "3.1.3",
    "prebuild-install/tar-fs": "2.1.5",
    "socket.io-parser": "4.2.6",
    "socks": "2.8.9",
    "shell-quote": "1.10.0",
    "svgo": "3.3.4",
    "tar": "7.5.22",
    "unstorage": "1.17.5",
    "@vueuse/head/@unhead/vue": "2.1.15",
    "vite": "6.4.3",
    "vite/picomatch": "4.0.5",
    "ws": "8.21.0",
    "yaml": "2.9.0"
  },
  "packageManager": "yarn@4.9.1",
  "devDependencies": {
    "@types/matter-js": "^0.19.7",
    "@types/node": "^26.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.6.3",
    "vue-tsc": "^3.3.5"
  }
}
